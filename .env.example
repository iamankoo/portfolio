# Required — Resend API key for the contact form
RESEND_API_KEY=

# Optional — canonical site URL, used to resolve absolute Open Graph / Twitter
# share-preview image URLs. On Vercel this is auto-detected; set it explicitly
# once a custom domain is attached (e.g. https://aniketraj.dev)
NEXT_PUBLIC_SITE_URL=

# Optional — WebSocket server URL for realtime features (live cursors, chat, presence)
# Leave empty to disable realtime features entirely
NEXT_PUBLIC_WS_URL=

# Optional — Umami analytics
UMAMI_DOMAIN=
UMAMI_SITE_ID=
